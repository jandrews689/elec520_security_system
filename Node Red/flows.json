        "id": "ab4a24166c499b03",
        "type": "function",
        "z": "9088ffe0b9f7bcfc",
        "name": "parseSystem",
        "func": "// node.warn(\"Incoming topic: \" + msg.topic);\n\n// Example topic: ELEC520/security/f/1/r/1/cs\nlet topic = msg.topic;\n\n// node.warn(\"Topic seen by parser: '\" + topic + \"'\");\n// Extract floor or system section\nlet match = topic.match(/ELEC520\\/security\\/(hw)\\/(s)\\/(\\w+)$/);\n\nnode.warn(match);\n\nif (!match) {\n    // node.warn(\"Unexpected system topic:\n    \n    return null;\n}\n\nlet outputs = new Array(2).fill(null);\n\n// match[1] will be \"st\" ELEC520/security/s/st\nlet subTopic = match[3];\n\nif (subTopic === \"st\") {\n    //System state topic\n    outputs[0] = msg.payload;\n} else if (subTopic === \"ke\") {\n    //System state keypad\n    outputs[1] = msg.payload;\n}\n\n",

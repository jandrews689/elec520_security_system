    {
        "id": "b397f1b249a32c2f",
        "type": "function",
        "z": "24cf997c7034cb7c",
        "name": "system state",
        "func": "// node.warn(\"Incoming topic: \" + msg.topic);\n\n// Example topic: ELEC520/security/f/1/r/1/cs\nlet topic = msg.topic;\n\n// node.warn(\"Topic seen by parser: '\" + topic + \"'\");\n// Extract floor or system section\nlet match = topic.match(/ELEC520\\/security\\/(hw)\\/s\\/(\\w+)$/);\n\n// node.warn(match);\n\nif (!match) {\n    node.warn(\"Unexpected system topic: \" + topic);\n    return null;\n}\n\n// match[1] will be \"st\" ELEC520/security/s/st\nlet subTopic = match[2];\n\nif (subTopic === \"st\") {\n    //System state topic\n    msg.systemState = msg.payload;\n    return msg;\n} else if (subTopic === \"cl\") {\n    return;\n}\n\n",
        "outputs": 1,

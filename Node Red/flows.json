    {
        "id": "cd9b3d01978e30ad",
        "type": "function",
        "z": "9088ffe0b9f7bcfc",
        "name": "ELEC520/security/#",
        "func": "// node.warn(\"Incoming topic: \" + msg.topic);\n\n// Example topic: ELEC520/security/f/1/r/1/cs\nlet topic = msg.topic;\n\n// node.warn(\"Topic seen by parser: '\" + topic + \"'\");\n// Extract floor or system section\nlet match = topic.match(/ELEC520\\/security\\/(hw|cl)\\/(f\\/(\\d+)|s)(\\/|$)/);\n\n// node.warn(match);\n\nif (match) {\n    let outputs = new Array(8).fill(null);\n\n    // if (match[1]) {\n    //     msg.systemState = \n    // }\n\n    if (match[2]) {\n        // Floor topic\n        msg.floor = parseInt(match[2]);\n        outputs[msg.floor - 1] = msg;\n        return outputs;\n    } else {\n        // System topic (s)\n        // node.warn(\"System topic received: \" + topic);\n        // optional: handle system message here or just ignore\n        return null;\n    }\n\n} else {\n    // node.warn(\"Unexpected topic format: \" + topic);\n    return null;\n}\n",
        "outputs": 8,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

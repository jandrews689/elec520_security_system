    {
        "id": "f89ad4a72f2fd450",
        "type": "function",
        "z": "d94627ca84a633a7",
        "name": "parseSystemData",
        "func": "// Example topics: ELEC520/security/hw/s/st , ELEC520/security/hw/s/ke\nlet topic = msg.topic;\n\n// Match only hardware system topics ending in /st or /ke\nlet match = topic.match(/ELEC520\\/security\\/hw\\/s\\/(st|ke)$/);\n\n\nif (!match) {\n    // node.warn(\"Unexpected topic: \" + topic);\n    return null;\n}\n\nlet outputs = [null, null];\nlet subTopic = match[1];\n\nif (subTopic === \"st\") {\n    outputs[0] = { payload: msg.payload }; // System state\n} else if (subTopic === \"ke\") {\n    outputs[1] = { payload: msg.payload }; // Keypad\n}\n\n\nreturn outputs;",
        "outputs": 2,
        "timeout": 0,
